<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 用户仍需在系统“使用情况访问”页面主动授权，才能查询其他App的蜂窝流量汇总。 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 允许高重要性提醒渠道在用户未关闭系统或渠道振动时提供振动反馈。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 后台Alarm触发后短时播放用户选择的系统提示音，服务最多运行五秒并自动退出。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- OTA下载完成后仍由用户在Android系统安装界面确认，不执行静默安装。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12及以上需要用户在系统页面单独允许，定时提醒才能避开较大的非精确时间窗口。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 10及以上读取系统计步传感器需要用户主动授予身体活动权限。 -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 天气只在用户打开今日页面时申请前台粗略位置，不申请后台或精确位置。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        只声明需要查询具备桌面入口的应用，用于用户自定义首页快捷方式。
        不申请能够查看全部安装包的QUERY_ALL_PACKAGES权限。
    -->
    <queries>
        <package android:name="com.tencent.mm" />
        <!-- 热点原平台App仅用于用户主动点击后的优先HTTPS跳转，不读取其任何应用数据。 -->
        <package android:name="com.sina.weibo" />
        <package android:name="com.baidu.searchbox" />
        <package android:name="com.zhihu.android" />
        <package android:name="com.ss.android.ugc.aweme" />

        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!-- Android 11及以上只查询能够提供系统文字转语音服务的引擎，用于本机英语离线发音。 -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_family_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_family_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HarleyApp"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HarleyApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            为记事本图文和文章包签发临时只读Content Uri。
            路径白名单仅覆盖cache/shared，接收方无法访问App数据库或其他私有文件。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            微信支付自动记账和未查看消息重复提醒共用系统通知监听服务。
            服务只能在用户主动授予“通知使用权”后由Android系统绑定，不能在后台自行提权。
        -->
        <service
            android:name=".notification.WechatNotificationListenerService"
            android:description="@string/wechat_notification_service_description"
            android:exported="false"
            android:label="@string/wechat_notification_service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            系统通知框架在部分小米版本中静默发布时，短时前台服务补充播放渠道所选系统铃声。
            服务不导出、不常驻，最多五秒后自动停止。
        -->
        <service
            android:name=".notification.ReminderAlertPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 只接收本应用创建的显式Alarm广播，用于重复展示未查看微信消息提醒。 -->
        <receiver
            android:name=".notification.WechatReminderReceiver"
            android:exported="false" />

        <!-- 用户点击本App微信提醒后，先结束后续提醒再跳转微信，不在桌面显示独立入口。 -->
        <activity
            android:name=".notification.WechatReminderOpenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.HarleyApp" />

        <!-- 只接收本应用按自定义日期和时间创建的显式Alarm广播。 -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- 只接收App内“10秒后台测试”创建的显式Alarm，不接受其他应用广播。 -->
        <receiver
            android:name=".notification.NotificationTestReceiver"
            android:exported="false" />

        <!-- 重启、应用升级或重新获得精确闹钟权限后，恢复通用提醒和微信等待提醒。 -->
        <receiver
            android:name=".reminder.ReminderBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件只显示App已缓存数据，不会在后台读取位置或访问天气接口。 -->
        <receiver
            android:name=".widget.TodayWeatherWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_weather_widget_info" />
        </receiver>

    </application>

</manifest>
