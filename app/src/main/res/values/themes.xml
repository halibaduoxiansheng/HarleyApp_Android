<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.HarleyApp" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 独立深色主题避免充电Activity创建瞬间继承主界面浅色背景而闪白。 -->
    <style name="Theme.HarleyApp.ChargingEffect" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#01030A</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#01030A</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
