<?xml version="1.0" encoding="utf-8"?>
<!--
    默认继续禁止HTTP明文流量，只为用户明确指定且目前仅提供HTTP服务的个人域名开放。
    includeSubdomains=true同时覆盖www.halibaduo.cn，避免为了一个网站放开整个App的HTTP访问。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">halibaduo.cn</domain>
    </domain-config>
</network-security-config>
